# Copy to .env for local runs (docker-compose reads these too).
# Never commit a real .env file — it's already in .gitignore.

PGHOST=localhost
PGPORT=5432
PGDATABASE=cafetwin
PGUSER=postgres
PGPASSWORD=cafetwin123
PGSSLMODE=disable          # set to "require" on managed Postgres (Render/Railway/RDS)

NODE_ENV=development
CORS_ORIGINS=*             # comma-separated allow-list in production, e.g. https://yourname.github.io
RATE_LIMIT_PER_MIN=120
API_KEY=                   # leave blank locally; set a long random value in production

# --- Squid gateway automation (optional) ---
# Leave SQUID_HOST blank to dry-run: the backend just logs what it would
# do instead of connecting anywhere. Fill these in once you have a real
# Squid gateway reachable over SSH — see squid_proxy/SQUID_SETUP.md.
SQUID_HOST=
SQUID_SSH_USER=cafetwin
SQUID_SSH_PORT=22
SQUID_SSH_KEY_PATH=
SQUID_SCRIPT_PATH=/opt/cafetwin/toggle_throttle.sh
SQUID_SSH_STRICT_HOST_CHECK=false
